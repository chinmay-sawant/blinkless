/dist/

# Leftover PDFs from the removed samples-python target under output/python/.
# Ignore the bulk fixture-*.pdf set; keep top-level fixture-55 / fixture-56 as
# committed smoke exceptions (plus architecture-diagram.pdf / invoice-inline.pdf).
output/python/fixture-*.pdf
!output/python/fixture-55-*.pdf
!output/python/fixture-56-*.pdf
output/python/pdf-*/fixture-*.pdf

# editor / OS noise
.DS_Store
*.swp
.pi-subagents
.pi*

# compliance tools
compliance/
verapdf/
.pdf-validators/
temps/

# bench tooling
scripts/puppeteer/node_modules/
# bench-external normally uses mktemp and removes its inputs/outputs, but keep
# accidental local copies out of the worktree. Result MD/CSV snapshots remain
# intentionally trackable under testdata/golden/benchmarks/.
scripts/bench-external-*.html
scripts/bench-external-*.pdf
testdata/golden/benchmarks/.bench-external/
knowledge-base

# Local Chromium source used for browser-reference test research.
/chromium/

# Local PDFs generated from the Chrome Flex case fixtures.
/test/chrome/pdf/
/test/chrome/cases/pdf/

# Local decision trail for long-running investigations.
/.audit/

__pycache__/

.vscode
pen/


# Agent batch proof notes (local only; not committed)
plans/**/phases/_proof-*.md

# Generated HTML reports (local only; not committed). These are rebuilt from
# the chat database and git history, so they are reproducible artifacts.
plans/**/report/

frontend/node_modules/

# Local git worktrees created for parallel agent sessions.
.worktrees/

